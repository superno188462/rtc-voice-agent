{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtc-voice-agent.local/schemas/memory_extraction.schema.json",
  "title": "Agent Memory Extraction Result",
  "description": "Structured output for independent profile and long-term-memory extraction.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile_updates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {"type": "string", "enum": ["upsert", "remove"]},
          "domain": {
            "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "description": "Open lowercase domain such as food, topic, skill, decision_style, or communication."
        },
        "relation": {"type": "string", "enum": ["likes", "dislikes", "prefers", "avoids", "proficient_in", "tends_to"]},
        "subject": {"type": "string", "minLength": 1, "maxLength": 120},
        "value": {"type": ["string", "null"], "maxLength": 120},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 500},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["action", "domain", "relation", "subject", "value", "evidence", "confidence"]
      }
    },
    "long_term_memories": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/long_term_memory"}
    }
  },
  "required": ["profile_updates", "long_term_memories"],
  "$defs": {
    "long_term_memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "enum": ["create", "update"]},
        "memory_id": {"type": ["string", "null"]},
        "memory_type": {"type": "string", "enum": ["episodic", "semantic", "procedural"]},
        "memory_role": {"type": "string", "enum": ["preference", "constraint", "fact", "event", "procedure"]},
        "scope": {"type": "string", "enum": ["global", "project"]},
        "project_name": {"type": ["string", "null"], "maxLength": 120},
        "content": {"type": "string", "minLength": 3, "maxLength": 300},
        "tags": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "enum": ["学习目标", "当前目标", "稳定背景", "项目经历", "其他"]}
        },
        "valid_until": {"type": ["string", "null"]},
        "source": {"type": "string", "enum": ["conversation"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      },
      "required": ["action", "memory_id", "memory_type", "memory_role", "scope", "project_name", "content", "tags", "valid_until", "source", "confidence", "evidence"]
    }
  }
}
