# OpenAI Chat Completions 兼容 LLM 服务；只由 Python 后端读取
# base URL 填到 /v1，不要包含 /chat/completions
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=replace-with-server-side-secret
LLM_MODEL=volc/Doubao-Seed-2.0-lite
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=256
LLM_HISTORY_LIMIT=10
# 与回答共用 API URL、Key 和模型；独立的非流式画像/记忆提取调用
LLM_MEMORY_EXTRACT_MAX_TOKENS=300
LLM_MEMORY_EXTRACT_TIMEOUT_SECONDS=20
AGENT_MEMORY_MIN_CONFIDENCE=0.75

# Agent Gateway 项目上下文（Key 仅由 Python 后端读取，不要配置到前端）
GATEWAY_CONTEXT_BASE_URL=http://127.0.0.1:8000/v1/context
GATEWAY_PROJECT_API_KEY=replace-with-server-side-project-key
# 可优先用 ID 精确读取模板；留空时使用分类与名称读取
GATEWAY_CONTEXT_TEMPLATE_ID=
# 网关提示词模板的分类与名称，需与网关项目内实际模板一致
GATEWAY_CONTEXT_TEMPLATE_CATEGORY=system
GATEWAY_CONTEXT_TEMPLATE_NAME=agent
# 短期消息默认 24 小时；允许 60 秒至 30 天
GATEWAY_CONTEXT_TTL_SECONDS=86400
# 最多扫描 5 页长期记忆（每页 50 条），再按本轮问题筛选
GATEWAY_CONTEXT_MEMORY_MAX_PAGES=5

# 仅旧版火山 CustomLLM callback 使用；为空时此兼容接口拒绝请求
CUSTOM_LLM_API_KEY=replace-with-a-long-random-secret

# 豆包 Seed ASR 2.0 实时流式识别；密钥只由 Python 后端读取
ASR_PROVIDER=volcengine
ASR_MODEL=doubao-seed-asr-2.0
# 可用统一地址覆盖当前 provider 的地址；留空时火山使用 ARK_ASR_WS_URL，网关使用 ASR_GATEWAY_WS_URL
ASR_WS_URL=
ASR_GATEWAY_WS_URL=wss://gateway.example.com/v1/audio/stream
# 网关需要鉴权时填写；当前网关草案按 Bearer Token 发送
ASR_GATEWAY_API_KEY=
ARK_ASR_API_KEY=replace-with-volcengine-speech-api-key
ARK_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_async
ARK_ASR_FILE_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
ARK_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 静音判停阈值（毫秒）；bigmodel_async 的二遍识别据此产出句级定稿
ARK_ASR_END_WINDOW_SIZE=800

# 当前单实例开发阶段的会话有效期
AGENT_SESSION_TTL_SECONDS=3600

# 本项目自己的 PostgreSQL 账号和登录会话库（不要与网关共用表/ORM）
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_TTL_SECONDS=43200
# 默认 development 使用非 Secure；APP_ENV=production 时默认启用 Secure，部署时也可显式覆盖
# 默认 lax；仅当前后端与前端处于跨站域名时使用 none，并同时启用 Secure/HTTPS
AUTH_COOKIE_SAMESITE=lax
# 每次已登录场景请求签发 RTC 凭据的有效秒数
RTC_TOKEN_TTL_SECONDS=3600
# 开启 Cookie 鉴权后，必须列出明确的前端来源，不能使用通配符
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 媒体机器人接入阶段配置；内部令牌只能由部署密钥管理系统注入
MEDIA_BOT_WS_URL=ws://media-bot:8080
MEDIA_BOT_INTERNAL_TOKEN=replace-with-internal-secret
