# OpenAI Chat Completions 兼容 LLM 服务；只由 Python 后端读取
# base URL 填到 /v1，不要包含 /chat/completions
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=replace-with-server-side-secret
# 旧的通用模型配置；各角色模型未填写时回退到这里
LLM_MODEL=volc/Doubao-Seed-2.0-lite
# 按任务独立选模型；模型名必须是该 API 服务已配置并授权的完整名称
LLM_ANSWER_MODEL=
LLM_SUBQUERY_MODEL=
LLM_MEMORY_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=256
LLM_HISTORY_LIMIT=10
# 仅在当前问题含上下文指代时调用子查询 LLM；调用超时后使用原问题检索
LLM_SUBQUERY_TIMEOUT_SECONDS=5
# 记忆分析使用独立模型配置；与其他调用共用 API URL 和 Key
LLM_MEMORY_EXTRACT_MAX_TOKENS=300
LLM_MEMORY_EXTRACT_TIMEOUT_SECONDS=20
AGENT_MEMORY_MIN_CONFIDENCE=0.75

# Agent Gateway 项目 API（向量和 Context 共用地址与项目 Key；只由后端读取）
GATEWAY_BASE_URL=http://127.0.0.1:8000/v1
GATEWAY_API_KEY=replace-with-server-side-project-key
# 启动时同步 system/agent 与 system/memory_extraction；代码提示词为准，有变更才更新网关。
# 短期消息默认 24 小时；允许 60 秒至 30 天
GATEWAY_CONTEXT_TTL_SECONDS=86400
# 最多扫描 5 页长期记忆（每页 50 条），再按本轮问题筛选
GATEWAY_CONTEXT_MEMORY_MAX_PAGES=5

# Agent Gateway 向量知识库（Collection 按项目 API Key 隔离）
# GATEWAY_BASE_URL 已在上方设置；地址以 /v1 或 /gateway/v1 结束，不包含 API 路径
GATEWAY_COLLECTION=rtc-agent-knowledge
GATEWAY_VECTOR_TIMEOUT_SECONDS=15
# 模型在知识库页面创建 collection 时选择；项目切片重叠默认 120 字符
RAG_TOP_K=5

# 长期记忆独立向量集合；使用与知识库分离的 collection，避免数据混查。
# 模型必须是 Gateway 已配置并授权的文本 Embedding 模型；集合创建后模型和 chunk_size 固定。
GATEWAY_MEMORY_COLLECTION=rtc-agent-memory
GATEWAY_MEMORY_EMBEDDING_MODEL=replace-with-authorized-embedding-model
GATEWAY_MEMORY_CHUNK_SIZE=1000
GATEWAY_MEMORY_TOP_K=12
GATEWAY_MEMORY_CONTEXT_LIMIT=12
GATEWAY_MEMORY_VECTOR_TIMEOUT_SECONDS=20

# 仅旧版火山 CustomLLM callback 使用；为空时此兼容接口拒绝请求
CUSTOM_LLM_API_KEY=replace-with-a-long-random-secret

# ASR 走 Gateway；API 地址和可选项目 Key 只由 Python 后端读取
ASR_PROVIDER=gateway
ASR_MODEL=volc/doubao-seed-asr-2.0
# 可用统一地址覆盖；留空时读取 ASR_GATEWAY_WS_URL
ASR_WS_URL=
ASR_GATEWAY_WS_URL=ws://119.45.48.180:8080/gateway/v1/audio/stream
# 网关 WebSocket 需要独立鉴权时填写；为空则不发送 Authorization
ASR_GATEWAY_API_KEY=
# 上游 ASR 连续无 PCM 多久后主动结束本次识别会话；新 PCM 到达时自动重连
ASR_IDLE_CLOSE_SECONDS=5
# 发送上游结束帧后，等待最终识别结果的最长秒数
ASR_FINALIZE_TIMEOUT_SECONDS=3

# TTS 直连火山方舟 Agent Plan，ASR 与 TTS 使用不同服务商
# API Key 只由后端读取。speaker 使用火山控制台中已授权的音色 ID。
VOLC_TTS_API_KEY=replace-with-volcengine-tts-api-key
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLC_TTS_TIMEOUT_SECONDS=45

# 当前单实例开发阶段的会话有效期
AGENT_SESSION_TTL_SECONDS=3600

# 本项目业务数据 PostgreSQL（不再保存本地账号或认证会话）
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# 后端到身份中心的服务端地址；不要配置到前端
IDENTITY_CENTER_BASE_URL=http://119.45.48.180:8080/identity-center
IDENTITY_CENTER_TIMEOUT_SECONDS=3
# 当前后端域名下的身份中心 opaque Cookie 属性；生产 HTTPS 必须开启 Secure
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# 每次已登录场景请求签发 RTC 凭据的有效秒数
RTC_TOKEN_TTL_SECONDS=3600
# 开启 Cookie 鉴权后，必须列出明确的前端来源，不能使用通配符
CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# 本地开发后端监听端口
PORT=8002

# 媒体机器人接入阶段配置；内部令牌只能由部署密钥管理系统注入
MEDIA_BOT_WS_URL=ws://media-bot:8080
MEDIA_BOT_INTERNAL_TOKEN=replace-with-internal-secret
