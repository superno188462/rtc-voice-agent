# OpenAI Chat Completions 兼容 LLM 服务；只由 Python 后端读取
# base URL 填到 /v1，不要包含 /chat/completions
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=replace-with-server-side-secret
LLM_MODEL=volc/Doubao-Seed-2.0-lite
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=256
LLM_HISTORY_LIMIT=10

# 豆包 Seed ASR 2.0 实时流式识别；密钥只由 Python 后端读取
ASR_PROVIDER=volcengine
ASR_MODEL=doubao-seed-asr-2.0
# 可用统一地址覆盖当前 provider 的地址；留空时火山使用 ARK_ASR_WS_URL，网关使用 ASR_GATEWAY_WS_URL
ASR_WS_URL=
ASR_GATEWAY_WS_URL=wss://gateway.example.com/v1/audio/stream
# 网关需要鉴权时填写；当前网关草案按 Bearer Token 发送
ASR_GATEWAY_API_KEY=
ARK_ASR_API_KEY=replace-with-volcengine-speech-api-key
ARK_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_async
ARK_ASR_FILE_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
ARK_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 静音判停阈值（毫秒）；bigmodel_async 的二遍识别据此产出句级定稿
ARK_ASR_END_WINDOW_SIZE=800

# 当前单实例开发阶段的会话有效期
AGENT_SESSION_TTL_SECONDS=3600

# 媒体机器人接入阶段配置；内部令牌只能由部署密钥管理系统注入
MEDIA_BOT_WS_URL=ws://media-bot:8080
MEDIA_BOT_INTERNAL_TOKEN=replace-with-internal-secret
